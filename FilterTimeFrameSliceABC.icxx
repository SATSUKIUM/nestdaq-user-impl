#include "FilterTimeFrameSliceABC.h"
#include "utility/MessageUtil.h"
#include "UnpackTdc.h"


#define DEBUG 0
#include "FilterTimeFrameSliceByTrackDebugger.h"

using nestdaq::FilterTimeFrameSliceABC;
namespace bpo = boost::program_options;


FilterTimeFrameSliceABC::FilterTimeFrameSliceABC()
   : fKTimer(1,KTimer(1000))
{
}


void FilterTimeFrameSliceABC::InitTask()
{
   using opt = OptionKey;

   fInputChannelName  = fConfig->GetValue<std::string>(opt::InputChannelName.data());
   fOutputChannelName = fConfig->GetValue<std::string>(opt::OutputChannelName.data());
   fName = fConfig->GetProperty<std::string>("id");
   std::istringstream ss(fName.substr(fName.rfind("-") + 1));
   ss >> fId;


   fNumDestination = GetNumSubChannels(fOutputChannelName);
   fPollTimeoutMS  = std::stoi(fConfig->GetProperty<std::string>(opt::PollTimeout.data()));

}

void FilterTimeFrameSliceABC::PreRun()
{
}

bool FilterTimeFrameSliceABC::ConditionalRun()
{
   const std::string_view funcname = "[FilterTimeFrameSliceABC::ConditionalRun] ";
   #if CHECK_COUT_LFTDC
   std::cout << std::endl << funcname << "Function called" << std::endl;
   #endif
   fDoCheck = fKTimer[0].Check();
   fDoCheck = false;
   
   // clear the time frame of previous cycle
   for (auto& tf : fTFs) {
      tf.Clear();
   }                
   fTFs.clear();

   // clear the logic filter of previous cycle
   for (auto& lf : fLFs) {
      lf.Clear();
   }
   fLFs.clear();
   
   FairMQParts inParts;
   FairMQParts outParts;
   if (Receive(inParts, fInputChannelName,0,1) <= 0) return true;

   #if CHECK_COUT_CONDITIONALRUN
   std::cout << "\tReveived " << inParts.Size() << std::endl;
   #endif
   ParseMessages(inParts);
   #if CHECK_COUT_CONDITIONALRUN
   std::cout << "\tParsed " << fTFs.size() << " time frames" << std::endl;
   #endif

   using copyUnit = uint32_t;

   auto outdataptr = std::make_unique<std::vector<copyUnit>>();
   auto outdata = outdataptr.get();

   int idxTFMETA = 0; // for synchronization of TF and LF
   int idxTFSLICE = 0; // for synchronization of TF and LF
   TLF* lf = &fLFs[idxTFMETA]; // TLF (ref: FrameContainer.h, LF header and LF TDC blocks)
   auto nTrig = lf->GetHeader()->numTrigs;
   #if CHECK_COUT_CONDITIONALRUN
   std::cout << "\tfLFs.size() = " << fLFs.size() << std::endl;
   std::cout << "\tTLF* lf = &fLFs[" << idxTFMETA << "]" << std::endl;
   std::cout << "\tlf->GetHeader()->numTrigs: " << nTrig << std::endl;
   std::cout << "\tlf->GetHeader()->length: " << lf->GetHeader()->length << std::endl;
   std::cout << "\tlf->GetHeader()->hLength: " << lf->GetHeader()->hLength << std::endl;
   TTT* ttt = lf->at(0);
   std::cout << "\tTTT* ttt = lf->at(0)" << std::endl;
   std::cout << "\t\tttt->GetHeader()->length: " << ttt->GetHeader()->length << std::endl;
   std::cout << "\t\tttt->GetHeader()->hLength: " << ttt->GetHeader()->hLength << std::endl;
   std::cout << "\t\tttt->GetNumData(): " << ttt->GetNumData() << std::endl;
   std::cout << "\t\tttt->GetData()[0]: " << ttt->GetData()[0].time << std::endl;
   #endif
   TTT* lfTdcBlock = nullptr;

   #if CHECK_COUT_CONDITIONALRUN
   std::cout << "\tcheck point" << std::endl;
   #endif

   #if CHECK_COUT_LFTDC
   std::cout << funcname << "fTFs.size() = " << fTFs.size() << std::endl;
   #endif
   for (uint64_t ifrm = 0, nfrm = fTFs.size(); ifrm < nfrm; ++ifrm) {
      #if CHECK_COUT_CONDITIONALRUN
      std::cout << "\t\tcheck point: ifrm = " << ifrm << std::endl;
      #endif
      auto& tf = fTFs[ifrm];
      bool doKeep = false;

      if (tf.GetHeader()->type == TimeFrame::META) {
         #if CHECK_COUT_CONDITIONALRUN
         std::cout << "\t\tTF type: META" << std::endl;
         #endif
         lf = &fLFs[idxTFMETA];
         
         #if CHECK_COUT_LFTDC
         nTrig = lf->GetHeader()->numTrigs;
         std::cout << funcname << idxTFMETA << "-th META TF: numTrigs = " << nTrig << std::endl;
         #endif

         #if CHECK_COUT_CONDITIONALRUN
         std::cout << "\t\tlf = &fLFs[" << idxTFMETA << "]" << std::endl;
         #endif
         idxTFMETA++;
         idxTFSLICE = 0;

         #if CHECK_COUT_CONDITIONALRUN
         std::cout << "\t\tcheck point: idxTFMETA = " << idxTFMETA << std::endl;
         #endif
         lfTdcBlock = lf->at(0); // ContainerFrame TLFにはLF TDC block(DataFrame TTT)が一つだけ入っている(じゃあなんで入れ子にしてるん?)
         #if CHECK_COUT_CONDITIONALRUN
         std::cout << "\t\tlfTdcBlock = lf->at(0)" << std::endl;
         #endif

         doKeep = true;
      } // if (tf.GetHeader()->type == TimeFrame::META)
      else {
         #if CHECK_COUT_CONDITIONALRUN
         std::cout << "\t\tTF type: SLICE, idxTFSLICE = " << idxTFSLICE << std::endl;
         std::cout << "\t\tcheck point: lfTdcBlock->GetHeader()->length = " << lfTdcBlock->GetHeader()->length << std::endl;
// constexpr unsigned char FLT_TDC_TYPE {0xaa};
// struct TrgTime {
//     union {
//         struct {
//             uint32_t time;
//             uint32_t type;
//         };
//         unsigned char cdata[8]  {0, 0, 0, 0, 0, 0, 0, FLT_TDC_TYPE};
//     };
// };
         std::cout << "\t\tcatching LF TDC from LogicFilter block: Filter::v1::TrgTime lfTdc = lfTdcBlock->UncheckedAt(" << idxTFSLICE << ")" << std::endl;
         // Filter::v1::TrgTime lfTdc = lfTdcBlock->UncheckedAt(idxTFSLICE);
         std::cout << "\t\t\tcatched" << std::endl;
         // std::cout << "\t\t\tlfTdc.time = " << lfTdc.time << std::endl;
         #endif
         fLFTDC4n = lfTdcBlock->UncheckedAt(idxTFSLICE).time;
         #if CHECK_COUT_CONDITIONALRUN
         std::cout << "\t\tLF TDC4n: " << fLFTDC4n << std::endl;
         #endif
         idxTFSLICE++;
         /*↓へ持って入る*/
         doKeep = ProcessSlice(tf);
      } // else

      if (!doKeep) continue;
      tf.GetHeader()->length = tf.GetRealLength();
      tf.CopyAllTo<copyUnit>(outdata);
   } // for (uint64_t ifrm = 0, nfrm = fTFs.size(); ifrm < nfrm; ++ifrm)
   // LOG(info) << outdata->size() ;
   
   FairMQMessagePtr msgall(MessageUtil::NewMessage(*this,std::move(outdataptr)));
   outParts.AddPart(std::move(msgall));
   

   if (fDoCheck) {
      LOG(info) << "num timeframes (including meta) : " << fTFs.size();
   }

   ////////////////////////////////////////////////////
   // Transfer the data to all of output channel
   ////////////////////////////////////////////////////
   auto poller = NewPoller(fOutputChannelName);
   while (!NewStatePending()) {
      auto direction = (fDirection++) % fNumDestination;
      poller->Poll(fPollTimeoutMS);
      if (poller->CheckOutput(fOutputChannelName, direction)) {
         if (Send(outParts, fOutputChannelName, direction) > 0) {
            // successfully sent
            break;
         } else {
            LOG(error) << "Failed to queue output-channel";
         }
      }
      if (fNumDestination==1) {
         std::this_thread::sleep_for(std::chrono::milliseconds(1));
      }
   }
   
   

   return true;
}

void FilterTimeFrameSliceABC::PostRun()
{
}


bool FilterTimeFrameSliceABC::ParseMessages(FairMQParts& inParts)
{

   // parse all the messages 
   int stfIdx = 0; // array index for stf
   int hbfIdx = 0; // array index for hbf
   int fltIdx = 0; // array index for flt
   TTF *timeFrame = nullptr;
   TLF *logicFilter = nullptr;
   Header<struct TimeFrame::Header> tfh;
   Header<struct Filter::Header> lfh;
   Header<struct Filter::TrgTimeHeader> tth;
   #if CHECK_COUT_PARSEMESSAGES
   std::cout << "[FilterTimeFrameSliceABC::ParseMessages] Function called" << std::endl;
   std::cout << "\tinParts.Size() = " << inParts.Size() << std::endl;
   #endif
   for (uint32_t i = 0, n = inParts.Size(); i < n; ++i) {
      auto& part = inParts[i];
      char* dataptr = reinterpret_cast<char*>(part.GetData());
      uint64_t nw = part.GetSize();
      char* dataend = dataptr + nw;
      
      while (dataptr < dataend) {
         auto magic = *reinterpret_cast<uint64_t*>(dataptr);
         if (magic == TimeFrame::MAGIC) {
            #if CHECK_COUT_PARSEMESSAGES
            std::cout << "\t\tmagic = TimeFrame::MAGIC";
            #endif
            // add new timeframe
            fTFs.resize(fTFs.size()+1);
            timeFrame = &(fTFs[fTFs.size() -1]);
            timeFrame->SetHeader(dataptr);
            stfIdx = -1; // reset stf index
            auto ns = timeFrame->GetHeader()->numSource;
            if (timeFrame->size() < ns) {
               timeFrame->resize(ns);
               for (decltype(ns) is = 0; is < ns; ++is) {
                  if ((*timeFrame)[is] == nullptr) {
                     (*timeFrame)[is] = new TSTF;
                  }
               }
            }
            dataptr += timeFrame->GetHeader()->hLength;
            #if CHECK_COUT_PARSEMESSAGES
            if(timeFrame->GetHeader()->type == TimeFrame::META) {
               std::cout << " (META)" << std::endl;
            } else if (timeFrame->GetHeader()->type == TimeFrame::SLICE) {
               std::cout << " (SLICE)" << std::endl;
            }
            std::cout << "\t\t\tfTFs.size() = " << fTFs.size() << std::endl;
            #endif
         } // if (magic == TimeFrame::MAGIC)
         else if (magic == Filter::MAGIC) {
            #if CHECK_COUT_PARSEMESSAGES
            std::cout << "\t\tmagic = Filter::MAGIC" << std::hex << magic << std::dec << std::endl;
            #endif
            fltIdx = -1; // reset flt index
            fLFs.resize(fLFs.size()+1);
            #if CHECK_COUT_PARSEMESSAGES
            std::cout << "\t\t\tfLFs.size() = " << fLFs.size() << std::endl;
            #endif
            logicFilter = &(fLFs[fLFs.size() -1]);
            logicFilter->SetHeader(dataptr);

            dataptr += logicFilter->GetHeader()->hLength;
            #if CHECK_COUT_PARSEMESSAGES
            std::cout << "\t\tlength: " << logicFilter->GetHeader()->length << std::endl;
            std::cout << "\t\thLength: " << logicFilter->GetHeader()->hLength << std::endl;
            std::cout << "\t\tnumTrigs: " << logicFilter->GetHeader()->numTrigs << std::endl;
            std::cout << "\t\tnumMessages: " << logicFilter->GetHeader()->numMessages << std::endl;
            #endif
#if 0         
            fLF.SetHeader(part.GetData());
            auto nm = fLF.GetHeader()->numMessages - 1;
            if (fLF.size() < nm) {
               fLF.resize(nm);
               for (decltype(nm) im = 0; im < nm; ++im) {
                  if (fLF[im] == nullptr) fLF[im] = new TTT;
               }
            }
#endif            
         } // else if (magic == Filter::MAGIC)
         else if (magic == Filter::TDC_MAGIC) {
            #if CHECK_COUT_PARSEMESSAGES
            std::cout << "\t\tmagic = Filter::TDC_MAGIC" << std::hex << magic << std::dec << std::endl;
            #endif
            fltIdx++;
            if(logicFilter->size() < fltIdx + 1){
               logicFilter->resize(fltIdx + 1);
               if(logicFilter->at(fltIdx) == nullptr){
                  logicFilter->at(fltIdx) = new TTT;
               }
            } // if(logicFilter != nullptr && logicFilter->size() < fltIdx + 1)

            logicFilter->at(fltIdx)->Set(dataptr);
            // logicFilter->at(fltIdx)->SetHeader(dataptr);
            dataptr += logicFilter->at(fltIdx)->GetHeader()->length;
            // #if CHECK_COUT_PARSEMESSAGES
            // std::cout << "\t\tlftdc4n: " << logicFilter->at(fltIdx)->GetHeader()->time << std::endl;
            // #endif
#if 0               
            auto& tdcf = *(fLF[fltIdx]);
            tdcf.Set(part.GetData());
            fltIdx++;
#endif         
         } else if (magic == SubTimeFrame::MAGIC) {
            // #if CHECK_COUT_PARSEMESSAGES
            // std::cout << "\t\tmagic = SubTimeFrame::MAGIC" << std::hex << magic << std::dec << std::endl;
            // #endif
            hbfIdx = 0; // reset hbf index
            stfIdx ++;
            auto& stf = *((*timeFrame)[stfIdx]);
            stf.SetHeader(dataptr);
            dataptr += stf.GetHeader()->hLength;
         } // else if (magic == SubTimeFrame::MAGIC)
         else if (magic == HeartbeatFrame::MAGIC) {
            // #if CHECK_COUT_PARSEMESSAGES
            // std::cout << "\t\tmagic = HeartbeatFrame::MAGIC" << std::hex << magic << std::dec << std::endl;
            // #endif
            auto& stf = *((*timeFrame)[stfIdx]);
            if (stf.size() < hbfIdx+1) {
               stf.push_back(new THBF);
            }
            auto& hbf = *((*timeFrame)[stfIdx]->at(hbfIdx));
            hbf.Set(dataptr);
            hbfIdx++;
            dataptr += hbf.GetHeader()->length;
         }
         else {
            //LOG(info) << "Error with magic" << std::hex << magic;
            return false;
         } // else
      } // while (dataptr < dataend)
   } // for (uint32_t i = 0, n = inParts.Size(); i < n; ++i)
   return true;
} // bool FilterTimeFrameSliceABC::ParseMessages(FairMQParts& inParts)
   

